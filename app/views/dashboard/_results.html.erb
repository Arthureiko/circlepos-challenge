<div class="hidden group-aria-busy:flex absolute inset-0 z-10 items-center justify-center rounded-xl bg-white/70 backdrop-blur-sm">
  <div class="flex items-center gap-2 text-sm font-medium text-gray-600">
    <svg class="h-4 w-4 animate-spin text-gray-400" viewBox="0 0 24 24" fill="none">
      <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
      <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"></path>
    </svg>
    Loading comparison…
  </div>
</div>

<% case @state %>
<% when :error %>
  <div class="rounded-xl border border-rose-200 bg-rose-50 p-6 flex flex-col items-start gap-3">
    <p class="font-medium text-rose-700">We couldn't load the comparison.</p>
    <p class="text-sm text-rose-600"><%= @error_message %></p>
    <%= link_to "Retry", request.original_url, data: { turbo_frame: "dashboard_results" },
          class: "text-sm font-medium text-rose-700 underline underline-offset-2" %>
  </div>

<% when :empty %>
  <div class="rounded-xl border border-gray-200 bg-gray-50 p-10 flex flex-col items-center text-center gap-2">
    <p class="font-medium text-gray-700">No data for the selected filters.</p>
    <p class="text-sm text-gray-500">Try a different category, channel, or time range.</p>
  </div>

<% when :ok %>
  <% summary = @comparison["summary"] %>
  <% currency = @comparison["currency"] %>
  <div class="flex flex-col gap-6">
    <div class="flex flex-wrap items-baseline justify-between gap-2">
      <h2 class="text-base font-medium text-gray-900">
        <%= @comparison["store_name"] %> · <%= @comparison["region"] %>
      </h2>
      <span class="text-xs text-gray-400">
        <%= @months_data.size %> months · updated <%= currency %>
      </span>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div class="rounded-xl border border-gray-100 bg-white p-4 shadow-sm">
        <p class="text-xs font-medium text-gray-500">Sales (ex-tax)</p>
        <p class="mt-1 text-xl font-semibold text-gray-900"><%= format_money(summary["current_year_sales_ex_tax"], currency) %></p>
        <p class="mt-1 text-sm <%= delta_color_class(summary["delta_sales_pct"]) %>">
          <%= delta_arrow(summary["delta_sales_pct"]) %> <%= format_pct(summary["delta_sales_pct"]) %> vs last year
          (<%= format_money(summary["previous_year_sales_ex_tax"], currency) %>)
        </p>
      </div>

      <div class="rounded-xl border border-gray-100 bg-white p-4 shadow-sm">
        <p class="text-xs font-medium text-gray-500">Gross profit (ex-tax)</p>
        <p class="mt-1 text-xl font-semibold text-gray-900"><%= format_money(summary["current_year_gross_profit_ex_tax"], currency) %></p>
        <p class="mt-1 text-sm <%= delta_color_class(summary["delta_gross_profit_pct"]) %>">
          <%= delta_arrow(summary["delta_gross_profit_pct"]) %> <%= format_pct(summary["delta_gross_profit_pct"]) %> vs last year
          (<%= format_money(summary["previous_year_gross_profit_ex_tax"], currency) %>)
        </p>
      </div>
    </div>

    <div class="overflow-x-auto rounded-xl border border-gray-100 bg-white shadow-sm">
      <table class="min-w-full text-sm">
        <thead>
          <tr class="border-b border-gray-100 text-left text-xs uppercase tracking-wide text-gray-400">
            <th class="px-4 py-3 font-medium">Month</th>
            <th class="px-4 py-3 font-medium text-right">Sales (this yr)</th>
            <th class="px-4 py-3 font-medium text-right">Sales (last yr)</th>
            <th class="px-4 py-3 font-medium text-right">Sales Δ</th>
            <th class="px-4 py-3 font-medium text-right">Gross profit (this yr)</th>
            <th class="px-4 py-3 font-medium text-right">Gross profit Δ</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-50">
          <% @months_data.each do |m| %>
            <tr>
              <td class="px-4 py-2.5 whitespace-nowrap text-gray-700"><%= format_month_label(m["month"]) %></td>
              <td class="px-4 py-2.5 text-right text-gray-700"><%= format_money(m["current_year_sales_ex_tax"], currency) %></td>
              <td class="px-4 py-2.5 text-right text-gray-400"><%= format_money(m["previous_year_sales_ex_tax"], currency) %></td>
              <td class="px-4 py-2.5 text-right font-medium <%= delta_color_class(m["delta_sales_pct"]) %>">
                <%= delta_arrow(m["delta_sales_pct"]) %> <%= format_pct(m["delta_sales_pct"]) %>
              </td>
              <td class="px-4 py-2.5 text-right text-gray-700"><%= format_money(m["current_year_gross_profit_ex_tax"], currency) %></td>
              <td class="px-4 py-2.5 text-right font-medium <%= delta_color_class(m["delta_gross_profit_pct"]) %>">
                <%= delta_arrow(m["delta_gross_profit_pct"]) %> <%= format_pct(m["delta_gross_profit_pct"]) %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
<% end %>
